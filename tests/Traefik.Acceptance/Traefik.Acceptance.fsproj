<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Traefik.Acceptance</AssemblyName>
    <RootNamespace>Dorothy.Traefik.Acceptance</RootNamespace>
    <WarningsAsErrors>$(WarningsAsErrors);FS0020;FS3221</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Dorothy.DSL/Dorothy.DSL.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
