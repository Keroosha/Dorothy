<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>keroosha-iac-helper</AssemblyName>
    <RootNamespace>Dorothy.HostHelper</RootNamespace>
    <PublishAot>true</PublishAot>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <DefineConstants>$(DefineConstants);HOST_HELPER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="Fail2BanCliData.fs" />
    <Compile Include="../Dorothy.DSL/FirewalldModel.fs" Link="FirewalldModel.fs" />
    <Compile Include="Firewalld.fs" />
    <Compile Include="Apt.fs" />
    <Compile Include="Ufw.fs" />
    <Compile Include="Traefik.fs" />
    <Compile Include="DockerEngine.fs" />
    <Compile Include="DockerJob.fs" />
    <Compile Include="Swapfile.fs" />
    <Compile Include="Sshd.fs" />
    <Compile Include="Fail2BanNative.fs" />
    <Compile Include="Fail2Ban.fs" />
    <Compile Include="Users.fs" />
    <Compile Include="Sudo.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
