<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>keroosha-iac-helper</AssemblyName>
    <RootNamespace>Dorothy.HostHelper</RootNamespace>
    <PublishAot>true</PublishAot>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <DefineConstants>$(DefineConstants);HOST_HELPER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="Fail2BanCliData.fs" />
    <Compile Include="../Dorothy.DSL/FirewalldModel.fs" Link="FirewalldModel.fs" />
    <Compile Include="../Dorothy.DSL/FirewalldGateModel.fs" Link="FirewalldGateModel.fs" />
    <Compile Include="../Dorothy.DSL/TraefikPathModel.fs" Link="TraefikPathModel.fs" />
    <Compile Include="FieldRuntime.fs" />
    <Compile Include="FirewalldRuntime.fs" />
    <Compile Include="FirewalldLifecycle.fs" />
    <Compile Include="FirewalldRecoveryProof.fs" />
    <Compile Include="FirewalldReferences.fs" />
    <Compile Include="FirewalldBindingTransfer.fs" />
    <Compile Include="../Dorothy.DSL/TraefikHttpGraphModel.fs" Link="TraefikHttpGraphModel.fs" />
    <Compile Include="../Dorothy.DSL/TraefikStatic.fs" Link="TraefikStatic.fs" />
    <Compile Include="../Dorothy.DSL/TraefikTlsSettings.fs" Link="TraefikTlsSettings.fs" />
    <Compile Include="../Dorothy.DSL/TraefikDynamic.fs" Link="TraefikDynamic.fs" />
    <Compile Include="../Dorothy.DSL/TraefikSettings.fs" Link="TraefikSettings.fs" />
    <Compile Include="Firewalld.fs" />
    <Compile Include="FirewalldDockerGate.fs" />
    <Compile Include="Apt.fs" />
    <Compile Include="Ufw.fs" />
    <Compile Include="Traefik.fs" />
    <Compile Include="DockerEngine.fs" />
    <Compile Include="DockerJob.fs" />
    <Compile Include="Swapfile.fs" />
    <Compile Include="Sshd.fs" />
    <Compile Include="Fail2BanNative.fs" />
    <Compile Include="Fail2Ban.fs" />
    <Compile Include="Users.fs" />
    <Compile Include="Sudo.fs" />
    <Compile Include="Content.fs" />
    <Compile Include="Services.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
