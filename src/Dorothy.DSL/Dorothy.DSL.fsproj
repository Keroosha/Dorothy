<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
        <Compile Include="Quantities.fs" />
        <Compile Include="Ufw.fs" />
        <Compile Include="Certificates.fs" />
        <Compile Include="Traefik.fs" />
        <Compile Include="Docker.fs" />
        <Compile Include="Swapfile.fs" />
        <Compile Include="Fail2Ban.fs" />
        <Compile Include="Sshd.fs" />
        <Compile Include="Users.fs" />
        <Compile Include="Sudo.fs" />
        <Compile Include="HostContent.fs" />
        <Compile Include="HostContentInputs.fs" />
        <Compile Include="Domain.fs" />
        <Compile Include="DockerResources.fs" />
        <Compile Include="Resources.fs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Pulumi" Version="3.116.2" />
        <PackageReference Include="Pulumi.Docker" Version="5.2.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    </ItemGroup>

</Project>
